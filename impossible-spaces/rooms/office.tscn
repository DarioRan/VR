[node name="Office" type="Node3D"]
script = ExtResource("1_room")
room_id = &"office"
display_name = "Office"
floor_size = Vector2(1.75, 1.75)
max_stride_gain = 1.0
editor_description = "Office (owner: Dario). Greybox from the plan's floor plan blueprint.
Origin = centre of the taped square, x east, north = -z.
Room zone: x -1.25 to +0.5, z -0.5 to +1.25 (1.75 x 1.75 m, gain 1.0).
Doors: N1 (north wall, centre x -0.8) -> hallway; E2 (east wall, centre z +0.85) <- corridor from bedroom.
Keep 0.75 m clear inside each door; furniture only on the west and south walls.
SafeSlot: the P2 safe (SW corner, facing east). CodeClue: static code note on the west wall (until the portal window)."

